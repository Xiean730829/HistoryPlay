{
  "name": "history-play",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "workspaces": [
    "apps/museum-web",
    "packages/contracts-ts"
  ],
  "scripts": {
