{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historyplay.dev/contracts/schemas/v1/story.schema.json",
  "title": "Story",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "entry_node_id", "node_ids"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/namespacedId"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/nonEmptyText"
    },
    "entry_node_id": {
      "$ref": "common.schema.json#/$defs/namespacedId"
    },
    "node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/namespacedId"
      }
    },
    "artifact_id": {
      "$ref": "common.schema.json#/$defs/namespacedId"
    },
    "return_to_exhibit": {
      "type": "boolean"
    }
  }
}
