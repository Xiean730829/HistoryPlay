{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historyplay.dev/contracts/schemas/v1/story-node.schema.json",
  "title": "StoryNode",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "story_id", "fact_grade", "allowed_actions", "exits"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/namespacedId"
    },
    "story_id": {
      "$ref": "common.schema.json#/$defs/namespacedId"
    },
    "fact_grade": {
      "$ref": "common.schema.json#/$defs/factGrade"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability"],
      "properties": {
        "capability": {
          "$ref": "common.schema.json#/$defs/capabilityId"
        },
        "asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/namespacedId"
          }
        }
      }
    },
    "narration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "observe",
          "ask",
          "switch_perspective",
          "choose_route",
          "compare_evidence",
          "enter_hypothesis",
          "continue_story",
          "return_to_exhibit"
        ]
      }
    },
    "enter_when": {
      "$ref": "#/$defs/condition"
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "exits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "target_node_id"],
        "properties": {
          "action": {
            "enum": [
              "continue_story",
              "choose_route",
              "enter_hypothesis",
              "return_to_exhibit"
            ]
          },
          "target_node_id": {
            "$ref": "common.schema.json#/$defs/namespacedId"
          },
          "when": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "return_checkpoint": {
      "type": "boolean"
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {
          "enum": ["all", "any", "equals", "greater_or_equal", "has_discovery"]
        },
        "path": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_.]{0,79}$"
        },
        "value": {
          "type": ["boolean", "number", "string"]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path"],
      "properties": {
        "op": {
          "enum": ["set", "add_discovery"]
        },
        "path": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_.]{0,79}$"
        },
        "value": {
          "type": ["boolean", "number", "string"]
        }
      }
    }
  }
}
