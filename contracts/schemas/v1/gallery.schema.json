{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historyplay.dev/contracts/schemas/v1/gallery.schema.json",
  "title": "Gallery",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "region", "status", "stations"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/namespacedId"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/nonEmptyText"
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z]{2}(\\.[a-z0-9-]+)?$"
        },
        "label": {
          "$ref": "common.schema.json#/$defs/nonEmptyText"
        }
      }
    },
    "status": {
      "enum": ["open", "planned", "closed"]
    },
    "presentation_kind": {
      "enum": ["river", "song_scroll"],
      "description": "Client presentation family; does not change the authoritative station order."
    },
    "scrolls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scroll"
      },
      "uniqueItems": true,
      "description": "Optional authored scroll scenes for a non-river gallery. Each scroll has a stable ID, stations, a licensed background asset, and 0–1 normalized hotspots."
    },
    "default_station_id": {
      "$ref": "common.schema.json#/$defs/namespacedId"
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/station"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "open"}},
        "required": ["status"]
      },
      "then": {"required": ["default_station_id"]}
    },
    {
      "if": {
        "properties": {"presentation_kind": {"const": "song_scroll"}},
        "required": ["presentation_kind"]
      },
      "then": {
        "required": ["scrolls"],
        "properties": {
          "scrolls": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "hotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_id", "x", "y", "width", "height", "label"],
      "properties": {
        "station_id": {
          "$ref": "common.schema.json#/$defs/namespacedId"
        },
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "label": {"$ref": "common.schema.json#/$defs/nonEmptyText"}
      }
    },
    "scroll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "theme", "background_asset_id", "interpretation_label", "station_ids", "hotspots"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/namespacedId"},
        "title": {"$ref": "common.schema.json#/$defs/nonEmptyText"},
        "theme": {"$ref": "common.schema.json#/$defs/nonEmptyText"},
        "background_asset_id": {"$ref": "common.schema.json#/$defs/namespacedId"},
        "interpretation_label": {"$ref": "common.schema.json#/$defs/nonEmptyText"},
        "station_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/namespacedId"}
        },
        "hotspots": {
          "type": "array",
          "items": {"$ref": "#/$defs/hotspot"}
        }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "time_range", "placement_basis", "artifact_id"],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/namespacedId"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "description": "Stable curator-defined order, independent from frame coordinates or uncertain date overlap."
        },
        "time_range": {
          "$ref": "common.schema.json#/$defs/timeRange"
        },
        "placement_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Why this object belongs at this point in the visitor route; do not imply a precise creation order when dates overlap."
        },
        "artifact_id": {
          "$ref": "common.schema.json#/$defs/namespacedId"
        },
        "comparison_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/namespacedId"
          },
          "description": "Other real artifacts shown for comparison at this station, with their own identity and region retained."
        },
        "side": {
          "enum": ["left", "center", "right"]
        }
      }
    }
  }
}
