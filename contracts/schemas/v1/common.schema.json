{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historyplay.dev/contracts/schemas/v1/common.schema.json",
  "title": "Common contract definitions",
  "$defs": {
    "namespacedId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-z]{2}(\\.[a-z0-9-]+){2,8}$",
      "description": "Stable runtime ID such as cn.tang.artifact.stele. Titles may change; IDs must not."
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_year", "end_year", "precision"],
      "properties": {
        "start_year": {
          "type": "integer",
          "description": "Inclusive start in astronomical year numbering."
        },
        "end_year": {
          "type": "integer",
          "description": "Inclusive end in astronomical year numbering."
        },
        "precision": {
          "enum": ["year", "decade", "century", "range", "unknown"]
        },
        "calendar_note": {
          "type": "string",
          "maxLength": 200
        },
        "display_label": {
          "type": "string",
          "maxLength": 80
        },
        "uncertainty": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "factGrade": {
      "enum": ["F", "R", "C", "H", "U"],
      "description": "F fact, R reconstruction, C creation, H hypothesis, U unknown or disputed."
    },
    "capabilityId": {
      "enum": [
        "artifact3d",
        "comic",
        "map",
        "timeline",
        "relationship_graph",
        "compare"
      ]
    },
    "opaqueId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Session, request or receipt ID. Not a content namespaced ID and not a permission."
    },
    "nonNegativeInt": {
      "type": "integer",
      "minimum": 0
    },
    "sessionMode": {
      "enum": ["explore", "story", "qa", "hypothesis"]
    },
    "commandAction": {
      "enum": [
        "open_artifact",
        "enter_story",
        "continue_story",
        "pause_story",
        "return_to_story",
        "focus_detail",
        "set_view",
        "choose_action"
      ],
      "description": "Frozen command actions. New exhibits do not add tools; new mechanisms add an action."
    },
    "variableValue": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      ]
    }
  }
}
