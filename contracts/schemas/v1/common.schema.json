{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historyplay.dev/contracts/schemas/v1/common.schema.json",
  "title": "Common contract definitions",
  "$defs": {
    "namespacedId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-z]{2}(\\.[a-z0-9-]+){2,8}$",
      "description": "Stable runtime ID such as cn.tang.artifact.stele. Titles may change; IDs must not."
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_year", "end_year", "precision"],
      "properties": {
        "start_year": {
          "type": "integer",
          "description": "Inclusive start in astronomical year numbering."
        },
        "end_year": {
          "type": "integer",
          "description": "Inclusive end in astronomical year numbering."
        },
        "precision": {
          "enum": ["year", "decade", "century", "range", "unknown"]
        },
        "calendar_note": {
          "type": "string",
          "maxLength": 200
        },
        "display_label": {
          "type": "string",
          "maxLength": 80
        },
        "uncertainty": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "factGrade": {
      "enum": ["F", "R", "C", "H", "U"],
      "description": "F fact, R reconstruction, C creation, H hypothesis, U unknown or disputed."
    },
    "capabilityId": {
      "enum": [
        "artifact3d",
        "comic",
        "map",
        "timeline",
        "relationship_graph",
        "compare"
      ]
    },
    "opaqueId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Session, request or receipt ID. Not a content namespaced ID and not a permission."
    },
    "nonNegativeInt": {
      "type": "integer",
      "minimum": 0
    },
    "sessionMode": {
      "enum": ["explore", "story", "qa", "hypothesis"]
    },
    "commandAction": {
      "enum": [
        "open_artifact",
        "enter_gallery",
        "move_next",
        "move_previous",
        "locate_artifact",
        "return_to_exhibit",
        "enter_story",
        "continue_story",
        "pause_story",
        "return_to_story",
        "focus_detail",
        "set_view",
        "choose_action"
      ],
      "description": "Frozen command actions. New exhibits do not add tools; new mechanisms add an action."
    },
    "actionParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]{0,79}$"
        },
        "input_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Untrusted player utterance. Must map to a declared intent before rules run."
        },
        "camera": {
          "$ref": "common.schema.json#/$defs/cameraPose"
        }
      }
    },
    "cameraPose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yaw", "pitch", "zoom"],
      "properties": {
        "yaw": {"type": "number", "minimum": -180, "maximum": 180},
        "pitch": {"type": "number", "minimum": -90, "maximum": 90},
        "zoom": {"type": "number", "exclusiveMinimum": 0, "maximum": 8}
      }
    },
    "variableValue": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      ]
    }
  }
}
