{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historyplay.dev/contracts/schemas/v1/artifact.schema.json",
  "title": "Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "museum",
    "time_range",
    "material",
    "category",
    "asset_ids"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/namespacedId"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/nonEmptyText"
    },
    "aliases": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "description": "Explicit search aliases, including common Chinese names; never inferred from unpublished sources."
    },
    "museum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "accession"],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/nonEmptyText"
        },
        "accession": {
          "$ref": "common.schema.json#/$defs/nonEmptyText"
        },
        "collection_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 500
        }
      }
    },
    "time_range": {
      "$ref": "common.schema.json#/$defs/timeRange"
    },
    "material": {
      "$ref": "common.schema.json#/$defs/nonEmptyText"
    },
    "category": {
      "$ref": "common.schema.json#/$defs/nonEmptyText"
    },
    "asset_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/namespacedId"
      },
      "description": "Logical digital asset IDs. Replacing a model does not change this artifact ID."
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_asset_id", "display", "teaser", "background_node_id"],
      "properties": {
        "preview_asset_id": {
          "$ref": "common.schema.json#/$defs/namespacedId",
          "description": "Stable ID of a real preview image; never inferred from asset_ids order."
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "asset_id"],
          "properties": {
            "kind": {
              "enum": ["model3d", "photo"],
              "description": "Explicit display medium, checked against the referenced asset kind."
            },
            "asset_id": {
              "$ref": "common.schema.json#/$defs/namespacedId",
              "description": "Stable ID of the display model or photograph."
            }
          }
        },
        "default_camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["orbit"],
          "properties": {
            "orbit": {
              "$ref": "common.schema.json#/$defs/nonEmptyText",
              "maxLength": 80,
              "description": "Curator-selected initial orbit preset for the bound display model."
            },
            "target_note": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "teaser": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "One-line exhibit introduction; the longer background remains in the referenced story node."
        },
        "background_node_id": {
          "$ref": "common.schema.json#/$defs/namespacedId",
          "description": "Stable story-node ID containing the single authored background narration."
        }
      },
      "description": "Optional explicit presentation bindings. The display source is a model or a photo, never whichever asset happens to be first."
    },
    "fact_card_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/namespacedId"
      }
    },
    "story_entry_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/namespacedId"
      }
    },
    "identity_unknown": {
      "type": "boolean"
    }
  }
}
