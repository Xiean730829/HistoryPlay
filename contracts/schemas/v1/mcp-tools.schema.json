{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historyplay.dev/contracts/schemas/v1/mcp-tools.schema.json",
  "title": "McpToolCall",
  "oneOf": [
    {
      "$ref": "#/$defs/connect"
    },
    {
      "$ref": "#/$defs/getContext"
    },
    {
      "$ref": "#/$defs/search"
    },
    {
      "$ref": "#/$defs/readContent"
    },
    {
      "$ref": "#/$defs/act"
    }
  ],
  "$defs": {
    "connect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "pair_code"],
      "properties": {
        "tool": {
          "const": "museum_connect"
        },
        "pair_code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9]+$"
        }
      }
    },
    "getContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool"],
      "properties": {
        "tool": {
          "const": "museum_get_context"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "receipt_id": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "query"],
      "properties": {
        "tool": {
          "const": "museum_search"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "enum": ["artifact", "event", "story", "fact"]
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "readContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "content_id"],
      "properties": {
        "tool": {
          "const": "museum_read_content"
        },
        "content_id": {
          "$ref": "common.schema.json#/$defs/namespacedId"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "action", "request_id", "expected_revision"],
      "properties": {
        "tool": {
          "const": "museum_act"
        },
        "action": {
          "$ref": "common.schema.json#/$defs/commandAction"
        },
        "target_id": {
          "$ref": "common.schema.json#/$defs/namespacedId"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "expected_revision": {
          "$ref": "common.schema.json#/$defs/nonNegativeInt"
        },
        "expected_view_revision": {
          "$ref": "common.schema.json#/$defs/nonNegativeInt"
        },
        "control_ticket": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    }
  }
}
